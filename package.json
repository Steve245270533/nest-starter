{
  "name": "nest-starter",
  "version": "0.0.1",
  "description": "NestJS 12 starter with native Zod schemas, Swagger and Prisma",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "cross-env NODE_ENV=development nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "cross-env NODE_ENV=production node dist/src/main.js",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" prisma.config.ts",
    "test": "tsc -p tsconfig.test.json && node --test \"dist-test/src/**/*.spec.js\"",
    "test:watch": "tsc -p tsconfig.test.json && node --test --watch \"dist-test/src/**/*.spec.js\"",
    "test:cov": "tsc -p tsconfig.test.json && node --test --experimental-test-coverage \"dist-test/src/**/*.spec.js\"",
    "test:debug": "tsc -p tsconfig.test.json && node --test --inspect \"dist-test/src/**/*.spec.js\"",
    "test:e2e": "tsc -p tsconfig.test.json && node --test \"dist-test/test/**/*.e2e-spec.js\"",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@nestjs/common": "^12.6.0",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.6.0",
    "@nestjs/platform-express": "^12.6.0",
    "@nestjs/swagger": "^12.1.2",
    "@prisma/adapter-mariadb": "7.10.1",
    "@prisma/client": "7.10.1",
    "config": "^5.0.1",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.10",
    "nest-winston": "^2.0.0",
    "nestjs-knife4j-plus": "^1.0.10",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.15",
    "@nestjs/schematics": "^12.0.16",
    "@nestjs/testing": "^12.5.1",
    "@swc/cli": "^0.8.2",
    "@swc/core": "^1.16.22",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "prisma": "7.10.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "webpack": "^5.113.0"
  },
  "type": "module",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "packageManager": "pnpm@11.13.0"
}
